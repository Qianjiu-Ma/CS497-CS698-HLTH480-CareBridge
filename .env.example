# Optional Gemini extraction. Leave blank to use deterministic fallback.
GEMINI_API_KEY=
# GEMINI_EXTRACTION_MODEL=

# Optional Google Cloud Translation settings.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_TRANSLATE_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_TRANSLATE_API_KEY=
# Optional pre-provisioned glossary ID in the configured regional location.
# Applied to requests with an explicit source language.
# GOOGLE_TRANSLATE_GLOSSARY_ID=
# CAREBRIDGE_DISABLE_DEMO_TRANSLATION=1

# Local server port. Defaults to 3000.
# PORT=3000
